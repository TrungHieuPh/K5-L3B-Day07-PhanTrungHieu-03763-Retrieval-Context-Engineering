# Copy to .env (never commit .env).

# Day 6 vector store: local Docker PostgreSQL + pgvector (password is local-only).
# Start it from the Day 6 repo:  cd <day6>/starter && docker compose -p day6_student_starter up -d --wait
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Path to the Day 6 starter folder (PDF, manifest and ingestion code used for pages.json).
DAY6_ROOT=../K5-L3-Day06-PhanTrungHieu-03763-DataIngestionEngineering/starter

# LLM controller (Step 2+). Put your own key in .env only.
GEMINI_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Free tier allows 5 generate_content requests per minute per model
GEMINI_RPM=5
